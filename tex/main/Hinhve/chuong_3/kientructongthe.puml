@startuml kientructongthe
!pragma layout smetana
left to right direction
!include <tupadr3/common>
!include <tupadr3/font-awesome-5/users>
!include <tupadr3/font-awesome-5/laptop>
!include <tupadr3/font-awesome-5/shield_alt>
!include <tupadr3/font-awesome-5/window_restore>
!include <tupadr3/font-awesome-5/server>
!include <tupadr3/font-awesome-5/database>
!include <tupadr3/font-awesome-5/hdd>
!include <tupadr3/font-awesome-5/microphone>
!include <tupadr3/font-awesome-5/cloud>
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 18
skinparam ArrowFontSize 16

FA5_USERS(user,"Người dùng")
FA5_LAPTOP(browser,"Trình duyệt")
FA5_SHIELD_ALT(caddy,"Máy chủ proxy")
FA5_WINDOW_RESTORE(heino,"Giao diện web\n(Next.js)")
FA5_SERVER(richter,"Máy chủ ứng dụng\n(Go)")
FA5_DATABASE(pg,"PostgreSQL\n(dữ liệu, hàng đợi)")
FA5_DATABASE(fdb,"FoundationDB\n(dữ liệu lớn)")
FA5_HDD(s3,"SeaweedFS\n(video, âm thanh)")
FA5_MICROPHONE(speaches,"Dịch vụ AI\n(Whisper, Piper)")
FA5_CLOUD(gemini,"Gemini API")

user --> browser
browser --> caddy : HTTP
caddy --> heino
caddy --> richter
heino --> richter : Connect RPC
richter --> pg
richter --> fdb
richter --> s3
richter --> speaches
richter --> gemini
@enduml

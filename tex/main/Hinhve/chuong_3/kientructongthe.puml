@startuml kientructongthe
!pragma layout smetana
left to right direction
!include <tupadr3/common>
!include <tupadr3/font-awesome-5/users>
!include <tupadr3/font-awesome-5/laptop>
!include <tupadr3/font-awesome-5/shield_alt>
!include <tupadr3/font-awesome-5/window_restore>
!include <tupadr3/font-awesome-5/server>
!include <tupadr3/font-awesome-5/database>
!include <tupadr3/font-awesome-5/hdd>
!include <tupadr3/font-awesome-5/microphone>
!include <tupadr3/font-awesome-5/cloud>
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam ArrowFontSize 12

FA5_USERS(user,"Người dùng\n(Giảng viên / Người học)")
FA5_LAPTOP(browser,"Trình duyệt web")
FA5_SHIELD_ALT(caddy,"Caddy\n(Reverse proxy)")
FA5_WINDOW_RESTORE(heino,"Giao diện web\n(heino, Next.js)")
FA5_SERVER(richter,"Máy chủ (richter)\nGo, worker hàng đợi")
FA5_DATABASE(pg,"PostgreSQL\ndữ liệu quan hệ\n+ hàng đợi tác vụ")
FA5_DATABASE(fdb,"FoundationDB\nbản chép lời,\ntiến độ xem")
FA5_HDD(s3,"SeaweedFS (S3)\nvideo, âm thanh")
FA5_MICROPHONE(speaches,"Speaches\nWhisper, Piper")
FA5_CLOUD(gemini,"Google Gemini API\n(dịch vụ ngoài)")

user --> browser
browser --> caddy : HTTP
caddy --> heino
caddy --> richter
heino --> richter : Connect RPC
richter --> pg
richter --> fdb
richter --> s3
richter --> speaches : HTTP
richter --> gemini : HTTPS
@enduml

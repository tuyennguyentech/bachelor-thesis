@startuml nextjs
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam shadowing false
skinparam sequenceMessageAlign center

participant "Trình duyệt" as B
participant "Next.js Proxy" as P
participant "Next.js (SSR)" as N
participant "Máy chủ ứng dụng" as R

B -> P : Yêu cầu trang
P -> P : Kiểm tra xác thực
P -> N : Cho qua
N -> R : Lấy dữ liệu (Connect RPC)
R --> N : Dữ liệu
N --> B : Trang đã kết xuất
@enduml

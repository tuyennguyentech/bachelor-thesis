COMPOSE_PROJECT_NAME=dyadia

# AI inference device: "cpu" (default) or "cuda" (requires GPU + nvidia-container-toolkit).
# Switch to cuda: set AI_DEVICE=cuda in .env.local and run:
#   podman compose -f compose.yml -f compose.gpu.yml up -d speaches piper-tts
AI_DEVICE=cpu

# ── Độ đồng thời cho AI LOCAL (mỗi service = 1 cặp: cap ở richter + workers ở service) ──
# Đặt mức song song dùng chung ở đây; nhớ để CẶP số bằng nhau.
#  Whisper (STT / speaches):
#    RICHTER_AI_WHISPER_MAX_CONCURRENT = semaphore chặn ở richter (app-side gate).
#    WHISPER__NUM_WORKERS              = số inference worker của speaches (CTranslate2).
#  Piper (TTS):
#    RICHTER_AI_PIPER_MAX_CONCURRENT   = semaphore chặn ở richter.
#    PIPER_NUM_WORKERS                 = số synthesis đồng thời tối đa ở piper (0 = unlimited).
# Lưu ý hiệu lực:
#  • compose tự nội suy ${WHISPER__NUM_WORKERS}/${PIPER_NUM_WORKERS} vào speaches/piper.
#  • richter chạy bằng go run qua container-shell KHÔNG kế thừa env container — container-shell.sh
#    đã `source .env` để richter thấy RICHTER_AI_* (viper: prefix RICHTER_, '.'→'_', AutomaticEnv).
RICHTER_AI_WHISPER_MAX_CONCURRENT=2
WHISPER__NUM_WORKERS=2
RICHTER_AI_PIPER_MAX_CONCURRENT=2
PIPER_NUM_WORKERS=2

FDB_API_VERSION=730
FDB_VERSION=7.3.69
FDB_COORDINATOR=fdb-coordinator
FDB_NETWORKING_MODE=container
FDB_COORDINATOR_PORT=4500

FDB_CLUSTER_FILE=./fdb.cluster

# Goose migration
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://dyadia:dyadia@postgres:5432/dyadia
GOOSE_MIGRATION_DIR=./sql/migrations
# GOOSE_TABLE=custom.goose_migrations

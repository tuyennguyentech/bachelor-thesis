COMPOSE_PROJECT_NAME=dyadia

# AI compute device: the base stack is ALWAYS CPU; GPU is enabled solely by the
# self-sufficient overlay (no AI_DEVICE knob — that footgun is gone). richter needs
# NO change either (it talks HTTP to speaches).
#   CPU:  podman compose up -d
#   GPU:  podman compose -f compose.yml -f compose.gpu.yml up -d speaches
# (GPU requires nvidia-container-toolkit + CDI + SELinux boolean — see docs/infra/podman-gpu.md.)

# ── Độ đồng thời AI LOCAL — Speaches phục vụ CẢ STT lẫn TTS (1 container) ──
# Đặt mức song song dùng chung ở đây.
#  STT (speech-to-text, Whisper qua Speaches):
#    RICHTER_AI_STT_MAX_CONCURRENT = semaphore chặn ở richter (app-side gate).
#    WHISPER__NUM_WORKERS          = số inference worker STT của speaches (tên env do image speaches quy định).
#  TTS (text-to-speech, giọng Piper qua Speaches /v1/audio/speech):
#    RICHTER_AI_TTS_MAX_CONCURRENT = semaphore chặn TTS ở richter.
# Lưu ý hiệu lực:
#  • compose tự nội suy ${WHISPER__NUM_WORKERS} vào speaches.
#  • richter chạy bằng go run qua container-shell KHÔNG kế thừa env container — container-shell.sh
#    đã `source .env` để richter thấy RICHTER_* (viper: prefix RICHTER_, '.'→'_', AutomaticEnv).
RICHTER_AI_STT_MAX_CONCURRENT=4
WHISPER__NUM_WORKERS=4
RICHTER_AI_TTS_MAX_CONCURRENT=4

# ── Model AI (provision vào Speaches lúc up container) — NGUỒN DUY NHẤT cho cả compose lẫn richter ──
# compose nội suy ${RICHTER_*} vào speaches (PRELOAD STT) + speaches-init (kéo model TTS).
# richter đọc cùng các biến này qua viper (RICHTER_ prefix) khi container-shell `source .env`.
RICHTER_STT_ENDPOINT=speaches:8000
RICHTER_STT_MODEL=Systran/faster-whisper-small
RICHTER_TTS_ENDPOINT=http://speaches:8000
RICHTER_TTS_VI_MODEL=speaches-ai/piper-vi_VN-vais1000-medium
RICHTER_TTS_VI_VOICE=vais1000
RICHTER_TTS_EN_MODEL=speaches-ai/piper-en_US-lessac-medium
RICHTER_TTS_EN_VOICE=lessac

FDB_API_VERSION=730
FDB_VERSION=7.3.69
FDB_COORDINATOR=fdb-coordinator
FDB_NETWORKING_MODE=container
FDB_COORDINATOR_PORT=4500

FDB_CLUSTER_FILE=./fdb.cluster

# ── Container images for richter/heino (SINGLE SOURCE for build + run) ──
# compose.build.yml BUILDS + tags + pushes these; compose.dev.yml RUNS them (pulls).
# namespace/project/app, versioned tag (quay supports the nested repo path).
DYADIA_RICHTER_IMAGE=quay.io/tuyennguyentech/bachelor-thesis/richter:0.0.2
DYADIA_HEINO_IMAGE=quay.io/tuyennguyentech/bachelor-thesis/heino:0.0.2

# ── Image build tool versions (SINGLE SOURCE — passed to the Dockerfiles as build
# args by compose.build.yml; FDB_VERSION above is reused for the FDB C client). ──
DYADIA_GO_VERSION=1.26
DYADIA_NODE_VERSION=24
DYADIA_BUF_VERSION=1.67.0
DYADIA_SQLC_VERSION=1.30.0
DYADIA_PNPM_VERSION=11.2.2
# Static ffmpeg copied into the richter runtime image (transcription audio extract).
DYADIA_FFMPEG_VERSION=7.1
# NOTE: heino build-time PUBLIC env (NEXT_PUBLIC_*) lives in the committed
# typescript/heino/.env (Next.js reads it); heino secrets live in the gitignored
# typescript/heino/.env.local. They are intentionally NOT duplicated here.

# ── Goose / DB migration config lives in SEPARATE files, NOT here ──
# This file is the shared RUNTIME base: it is auto-loaded by `podman compose`
# AND sourced by container-shell.sh into the host go-run richter process. Putting
# GOOSE_DBSTRING here is what previously broke `goose -env .env.test` (container-shell
# leaked the dev DBSTRING into the env, and goose's -env does not override pre-set vars).
# Migration config is now layered:
#   .env.goose        — shared: GOOSE_DRIVER + GOOSE_MIGRATION_DIR
#   .env.dev          — overlay: dev GOOSE_DBSTRING (DB dyadia)
#   .env.test         — overlay: test GOOSE_DBSTRING (DB dyadia_test)
# Run migrations via the wrapper which composes base+overlay (inheritance):
#   ./scripts/setup/environment.dev/container-shell.sh richter -- ./scripts/setup/environment.dev/goose.sh test up
#   ./scripts/setup/environment.dev/container-shell.sh richter -- ./scripts/setup/environment.dev/goose.sh dev up

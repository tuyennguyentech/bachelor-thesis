    ORGANIZATION {
        uuid id PK
        uuid created_by FK
        text name
        text slug UK
        organization_status status "active suspended archived"
        timestamp created_at
        timestamp updated_at
    }

    USER {
        uuid id PK
        citext email UK
        text password_hash
        text first_name
        text middle_name
        text last_name
        user_role role "normal admin"
        user_status status "active disabled pending"
        timestamp created_at
        timestamp updated_at
    }

    ORGANIZATION_MEMBER {
        uuid organization_id PK,FK
        uuid user_id PK,FK
        organization_role role "owner admin teacher student"
        member_status status "active invited suspended"
        timestamp created_at
        timestamp updated_at
    }


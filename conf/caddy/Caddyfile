# Caddy serves the dev/test stack on both HTTP (:80, all hosts) and HTTPS
# (https://caddy, internal self-signed cert). E2E runs over https://caddy so the
# browser exercises the real production cookie path (Secure cookies require TLS) —
# no security feature is disabled for tests. auto_https disable_redirects keeps
# plain http://caddy working for anything that still relies on it.
{
	auto_https disable_redirects
}

# Shared reverse-proxy rules for the whole stack.
(stack) {
	handle_path /api/storage/* {
		# Allow cross-origin PUT/GET for presigned S3 URLs from browser
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Access-Control-Max-Age "86400"

		@preflight {
			method OPTIONS
		}
		respond @preflight 204

		reverse_proxy storage:9000 {
			header_up Host {upstream_hostport}
			# SeaweedFS uses X-Forwarded-Host (if present) as the canonical host for
			# AWS SigV4 verification — leaving Caddy's default "X-Forwarded-Host: caddy"
			# breaks presigned URLs that were signed against host=storage:9000.
			header_up -X-Forwarded-Host
			# Strip SeaweedFS's own CORS headers so Caddy's headers above are the only ones
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Max-Age
			header_down -Access-Control-Allow-Credentials
		}
	}

	handle_path /api/richter/* {
		# Some richter streaming RPCs are quiet while backend workers call Whisper or
		# Gemini. Transcript extraction can spend several minutes in Whisper, so this
		# timeout must exceed the backend's 10m transcription deadline.
		reverse_proxy richter:8080 {
			transport http {
				read_timeout 15m
			}
		}
	}

	reverse_proxy heino:3000
}

# HTTPS for the "caddy" hostname with an internal (self-signed) cert. E2E uses
# https://caddy so Secure cookies behave exactly as in production.
https://caddy {
	tls internal
	import stack
}

# Plain HTTP on :80 for all hosts (unchanged) — kept for any non-test access.
:80 {
	import stack
}

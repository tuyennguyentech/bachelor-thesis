{
	# Local dev serves plaintext HTTP and internal-CA HTTPS side by side. Disable the
	# automatic HTTP→HTTPS redirect: it would target the default :443 (not the
	# published :8443) and would hijack the plaintext :80 site for Host=localhost.
	# Certs come from Caddy's own internal CA — there is no public domain in local dev.
	auto_https disable_redirects
}

# Shared routing, imported by both the HTTP and HTTPS site blocks below so the two
# listeners behave identically.
(routes) {
	handle_path /api/storage/* {
		# Allow cross-origin PUT/GET for presigned S3 URLs from browser
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Access-Control-Max-Age "86400"

		@preflight {
			method OPTIONS
		}
		respond @preflight 204

		reverse_proxy storage:9000 {
			header_up Host {upstream_hostport}
			# SeaweedFS uses X-Forwarded-Host (if present) as the canonical host for
			# AWS SigV4 verification — leaving Caddy's default "X-Forwarded-Host: caddy"
			# breaks presigned URLs that were signed against host=storage:9000.
			header_up -X-Forwarded-Host
			# Strip SeaweedFS's own CORS headers so Caddy's headers above are the only ones
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Max-Age
			header_down -Access-Control-Allow-Credentials
		}
	}

	handle_path /api/richter/* {
		# Some richter streaming RPCs are quiet while backend workers call Whisper or
		# Gemini. Transcript extraction can spend several minutes in Whisper, so this
		# timeout must exceed the backend's 10m transcription deadline.
		reverse_proxy richter:8080 {
			transport http {
				read_timeout 15m
			}
		}
	}

	reverse_proxy heino:3000
}

# HTTP — published on host :8080 (container :80). Hostless address matches every host
# (localhost, caddy, …), so internal service DNS (http://caddy) and Playwright E2E
# keep working unchanged.
:80 {
	import routes
}

# HTTPS — published on host :8443 (container :443). Caddy's internal CA issues a
# localhost certificate; browsers show a one-time self-signed warning in local dev
# (run `caddy trust` / import the root from .volumes/caddy-data to silence it).
https://localhost {
	tls internal
	import routes
}

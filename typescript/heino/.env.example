# heino environment reference.
#
# PUBLIC config is already COMMITTED in `typescript/heino/.env` (loaded by Next at
# build + dev) — you do NOT create these, they are in git:
#   NEXT_PUBLIC_RICHTER_BASE_URL=/api/richter   # browser → Caddy → richter (inlined at build)
#   RICHTER_BASE_URL=http://richter:8080        # server-side, internal DNS
#
# SECRETS are gitignored — create `typescript/heino/.env.local` (copy this file) with:

# HMAC secret for verifying access tokens — MUST match richter's jwt.secret config.
JWT_SECRET=your-jwt-secret-here

# heino PUBLIC config — COMMITTED to git.
#
# Per the official Next.js env convention, `.env` holds non-secret defaults that are
# safe to commit; secrets live in the gitignored `.env.local`. Committing this means a
# fresh clone / git worktree / CI already has the public config, so `next build` is
# reproducible without any machine-local file.

# Browser-side backend URL — inlined into the client bundle at build (NEXT_PUBLIC_*).
# Origin-relative: Caddy routes /api/richter → richter:8080. Same in every environment.
NEXT_PUBLIC_RICHTER_BASE_URL=/api/richter

# Server-side backend URL (Node, HTTP/2) — internal service DNS, read at runtime.
# Not a secret.
RICHTER_BASE_URL=http://richter:8080

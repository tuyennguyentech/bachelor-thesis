{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "typescript/heino/AGENTS.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -rf": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "snapshot": true
  }
}
